# Environment file for jetmon-bridge systemd service.
# Copy to /opt/jetmon-bridge/env and fill in credentials before starting the service.
# This file is loaded by EnvironmentFile= in jetmon-bridge.service.
#
# IMPORTANT: /opt/jetmon-bridge/env is NOT committed to the repo (it contains credentials).
# Restrict permissions: chmod 640 /opt/jetmon-bridge/env && chown root:jetmon-bridge /opt/jetmon-bridge/env

# Required: MySQL DSN pointing at the Jetmon read replica.
# Format: user:password@tcp(host:port)/database
JETMON_DSN=jetmon_bridge:password@tcp(mysql-replica.internal:3306)/jetmon_db

# Write-mode DSN — must point at the PRIMARY, not the read replica.
# Required when JETMON_WRITE=true; ignored in read-only mode.
# The DSN user needs SELECT, INSERT, UPDATE on jetpack_monitor_sites.
JETMON_WRITE_DSN=jetmon_bridge_rw:password@tcp(mysql-primary.internal:3306)/jetmon_db

# Listen address. Keep on loopback unless a reverse proxy handles TLS termination.
JETMON_ADDR=127.0.0.1:7400

# Per-request DB query timeout.
JETMON_READ_TIMEOUT=5s

# Set to true to enable POST /monitors and DELETE /monitors.
JETMON_WRITE=false

# Bearer token required on all requests. Leave empty to disable auth.
# Strongly recommended when write mode is enabled.
JETMON_TOKEN=

# Jetmon worker bucket number assigned to new monitors created in write mode.
# Must match an active bucket in the Jetmon deployment.
# To find active buckets: SELECT DISTINCT bucket_no FROM jetpack_monitor_sites WHERE monitor_active=1;
JETMON_BUCKET=0

# Optional SQLite-backed persistent event history.
# Empty disables history and keeps the synthetic single-event /events behavior.
JETMON_HISTORY_PATH=

# Poll interval for the history observer. Keep shorter than Jetmon's check interval.
JETMON_HISTORY_POLL_INTERVAL=15s

# Poll once at startup to seed observed state before normal polling.
JETMON_HISTORY_BOOTSTRAP=true
