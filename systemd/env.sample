# Environment file for jetmon-bridge systemd service.
# Copy to /opt/jetmon-bridge/env and set JETMON_DSN before starting the service.
# This file is loaded by EnvironmentFile= in jetmon-bridge.service.
#
# IMPORTANT: /opt/jetmon-bridge/env is NOT committed to the repo (it contains credentials).
# Restrict permissions: chmod 640 /opt/jetmon-bridge/env && chown root:jetmon-bridge /opt/jetmon-bridge/env

# Required: MySQL DSN pointing at the Jetmon read replica.
# Format: user:password@tcp(host:port)/database
JETMON_DSN=jetmon_bridge:password@tcp(mysql-replica.internal:3306)/jetmon_db

# Listen address. Keep on loopback unless a reverse proxy handles TLS termination.
JETMON_ADDR=127.0.0.1:7400

# Per-request DB query timeout.
JETMON_READ_TIMEOUT=5s
