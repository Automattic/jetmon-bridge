# Docker environment for jetmon-bridge.
# Copy to docker/.env and uncomment/edit as needed.
# docker/.env is gitignored and will not be committed.

# ── Real database mode ────────────────────────────────────────────────────────
# Uncomment and set JETMON_DSN to connect to Jetmon 1's actual read replica,
# then run: make up
#
# JETMON_DSN=jetmon_bridge:password@tcp(mysql-replica.internal:3306)/jetmon_db

# ── Local test mode ───────────────────────────────────────────────────────────
# Leave JETMON_DSN commented out. A local MySQL container seeded with test data
# will be used instead. Run: make up-local

# MySQL container settings (local test mode only)
MYSQL_ROOT_PASSWORD=jetmon_test
MYSQL_DATABASE=jetmon_db
MYSQL_LOCAL_PORT=3307

# ── Shared ────────────────────────────────────────────────────────────────────
# Host port the bridge container binds to
BRIDGE_LOCAL_PORT=7400

# Set to true to enable POST /monitors (create/reactivate) and DELETE /monitors (deactivate).
# Requires a DSN with write access. Defaults to false (read-only).
# JETMON_WRITE=false

# Bearer token required on all requests. Leave empty to disable auth.
# Strongly recommended when write mode is enabled.
# JETMON_TOKEN=
