# Docker environment for jetmon-bridge.
# Copy to docker/.env and uncomment/edit as needed.
# docker/.env is gitignored and will not be committed.

# ── Real database mode (docker-compose.yml only) ─────────────────────────────
# Set this to connect the bridge container to Jetmon 1's actual read replica.
# Run with: docker compose up --build
#
# JETMON_DSN=jetmon_bridge:password@tcp(mysql-replica.internal:3306)/jetmon_db

# ── Local test mode (docker-compose.yml + docker-compose.local.yml) ───────────
# Leave JETMON_DSN unset. The local overlay starts a MySQL container and seeds
# it with test data from docker/init.sql.
# Run with: docker compose -f docker-compose.yml -f docker-compose.local.yml up --build

# MySQL container settings (local test mode only)
MYSQL_ROOT_PASSWORD=jetmon_test
MYSQL_DATABASE=jetmon_db
MYSQL_LOCAL_PORT=3307

# ── Shared ────────────────────────────────────────────────────────────────────
# Host port the bridge container binds to
BRIDGE_LOCAL_PORT=7400
