# Local development environment for jetmon-bridge.
# Copy to .env and adjust values as needed.
# Do NOT commit .env — it may contain credentials.

# MySQL container settings
MYSQL_ROOT_PASSWORD=jetmon_test
MYSQL_DATABASE=jetmon_db

# Host port the MySQL container binds to (avoids conflicts with other local MySQL instances)
MYSQL_LOCAL_PORT=3307

# Host port the bridge container binds to
BRIDGE_LOCAL_PORT=7400
