# Docker environment for jetmon-bridge.
# Copy to docker/.env and uncomment/edit as needed.
# docker/.env is gitignored and will not be committed.

# ── Real database mode ────────────────────────────────────────────────────────
# Uncomment and set JETMON_DSN to connect to Jetmon 1's actual read replica,
# then run: make up
#
# JETMON_DSN=jetmon_bridge:password@tcp(mysql-replica.internal:3306)/jetmon_db
#
# If Jetmon v1.1 is running from its Docker Compose stack on jetmon-shared,
# use `make up-jetmon-v1` or set:
# JETMON_DSN=root:123456@tcp(jetmon-v1-mysql:3306)/jetmon_db

# ── Local test mode ───────────────────────────────────────────────────────────
# Leave JETMON_DSN commented out. A local MySQL container seeded with test data
# will be used instead. Run: make up-local

# MySQL container settings (local test mode only)
MYSQL_ROOT_PASSWORD=jetmon_test
MYSQL_DATABASE=jetmon_db
MYSQL_LOCAL_PORT=3307

# ── Shared ────────────────────────────────────────────────────────────────────
# Host port the bridge container binds to
BRIDGE_LOCAL_PORT=7400

# Set to true to enable POST /monitors (create/reactivate) and DELETE /monitors (deactivate).
# Requires JETMON_WRITE_DSN to be set (primary, not replica). Defaults to false (read-only).
# JETMON_WRITE=false

# MySQL DSN for write operations — must point at the primary, NOT the read replica.
# Required when JETMON_WRITE=true; ignored otherwise.
# JETMON_WRITE_DSN=jetmon_bridge_rw:password@tcp(mysql-primary.internal:3306)/jetmon_db

# Bearer token required on all requests. Leave empty to disable auth.
# Strongly recommended when write mode is enabled.
# JETMON_TOKEN=

# Jetmon worker bucket number assigned to new monitors created in write mode.
# Must match an active bucket in the Jetmon deployment (check bucket_no values
# in jetpack_monitor_sites). Wrong bucket = monitors never checked by Jetmon.
# JETMON_BUCKET=0

# Optional SQLite-backed persistent event history. Empty disables it.
# Docker mounts JETMON_HISTORY_DIR at /var/lib/jetmon-bridge. Use that path
# for persistent history that survives container recreation.
# JETMON_HISTORY_DIR=../data
# JETMON_HISTORY_PATH=/var/lib/jetmon-bridge/history.db
# JETMON_HISTORY_POLL_INTERVAL=15s
# JETMON_HISTORY_BOOTSTRAP=true
